{
  "family": "aegis-command-center",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::390068747483:role/aegis-ecs-execution",
  "containerDefinitions": [
    {
      "name": "command-center",
      "image": "390068747483.dkr.ecr.ap-southeast-2.amazonaws.com/aegis-command-center:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {"name": "AEGIS_DETECTOR", "value": "classical"},
        {"name": "AEGIS_VIDEO_SOURCE", "value": "rtsps://stream.skydio.com/demo/Skydio/color"},
        {"name": "AEGIS_LIVE_TELEMETRY", "value": "wss://stream.skydio-dev.com/data/demo"},
        {"name": "AEGIS_READ_TIMEOUT_MS", "value": "8000"},
        {"name": "OPENCV_FFMPEG_CAPTURE_OPTIONS", "value": "rtsp_transport;tcp"},
        {"name": "AEGIS_INGESTION_FPS", "value": "8"},
        {"name": "AEGIS_VISION_WAIT_MS", "value": "2000"},
        {"name": "AEGIS_BROADCAST_HZ", "value": "8"},
        {"name": "AEGIS_SYNTHETIC_GEO", "value": "false"},
        {"name": "AEGIS_LOW_CONFIDENCE_THRESHOLD", "value": "0.50"},
        {"name": "AEGIS_DEPLOYMENT_VERIFIED", "value": "false"},
        {"name": "AEGIS_MOCK_ACTIONS", "value": "false"},
        {"name": "AEGIS_COMPUTE_INSTANCE", "value": "Fargate X86_64, 1 vCPU, 2 GB, ap-southeast-2"},
        {"name": "AEGIS_KINESIS_REGION", "value": "ap-southeast-2"}
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/aegis-command-center",
          "awslogs-region": "ap-southeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
