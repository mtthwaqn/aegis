AEGIS_VIDEO_SOURCE=mock
# Classical perception is the default. Trained person/boat detection stays off
# while these are unset, even if weights exist on disk.
# AEGIS_DETECTOR=trained
# AEGIS_DETECTOR_WEIGHTS=data/training/runs/person-boat-sds/weights/best.pt
# AEGIS_DETECTOR_CONF=0.45
AEGIS_INGESTION_FPS=30
AEGIS_BROADCAST_HZ=25
AEGIS_MOCK_ACTIONS=true
AEGIS_API_TOKEN=
AEGIS_ALLOWED_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501","http://localhost:8000","http://127.0.0.1:8000"]
AEGIS_COMPUTE_INSTANCE=AWS Graviton3 c7g.xlarge + COOL
# Set only after Member 5 verifies the deployment and price; no fabricated cost metric.
# AEGIS_HOURLY_COMPUTE_COST_USD=0.136
# AEGIS_DEPLOYMENT_VERIFIED=true
# AEGIS_KINESIS_REGION=ap-southeast-1
# AEGIS_KINESIS_DATA_ENDPOINT=https://your-kinesis-data-endpoint
# AEGIS_VIDEO_SOURCE=kinesis://your-stream-name
AEGIS_DASHBOARD_BACKEND_URL=http://localhost:8000
